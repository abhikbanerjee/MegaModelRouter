    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "id": 5,
   "options": {},
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(routerlab_requests_total{strategy=~\"$strategy\"}[$__range]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Spend rate: routed vs always-strongest",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 7
   },
   "id": 6,
   "options": {},
   "targets": [
    {
     "refId": "A",
     "expr": "3600 * sum(rate(routerlab_cost_usd_total{strategy=~\"$strategy\"}[$__rate_interval]))",
     "legendFormat": "routed $/h"
    },
    {
     "refId": "B",
     "expr": "3600 * sum(rate(routerlab_baseline_cost_usd_total{strategy=~\"$strategy\"}[$__rate_interval]))",
     "legendFormat": "always-strongest $/h"
    }
   ]
  },
  {
   "type": "row",
   "title": "Strategy comparison",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "id": 7,
   "panels": []
  },
  {
   "type": "table",
   "title": "Scorecard by strategy (range)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 3,
     "custom": {
      "cellOptions": {
       "type": "color-text"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "accuracy"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "lcd"
        }
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "$ per 1k requests"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       },
       {
        "id": "decimals",
        "value": 4
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "saved vs strongest %"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "requests"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 10
   },
   "id": 8,
   "options": {},
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (strategy) (increase(routerlab_feedback_total{strategy=~\"$strategy\",correct=\"true\"}[$__range])) / sum by (strategy) (increase(routerlab_feedback_total{strategy=~\"$strategy\"}[$__range]))",
     "legendFormat": "",
     "format": "table",
     "instant": true
    },
    {
     "refId": "B",
     "expr": "1000 * sum by (strategy) (increase(routerlab_cost_usd_total{strategy=~\"$strategy\"}[$__range])) / sum by (strategy) (increase(routerlab_requests_total{strategy=~\"$strategy\"}[$__range]))",
     "legendFormat": "",
     "format": "table",
     "instant": true
    },
    {
     "refId": "C",
     "expr": "100 * (1 - sum by (strategy) (increase(routerlab_cost_usd_total{strategy=~\"$strategy\"}[$__range])) / sum by (strategy) (increase(routerlab_baseline_cost_usd_total{strategy=~\"$strategy\"}[$__range])))",
     "legendFormat": "",
     "format": "table",
     "instant": true
    },
    {
     "refId": "D",
     "expr": "histogram_quantile(0.95, sum by (le, strategy) (increase(routerlab_request_duration_seconds_bucket{strategy=~\"$strategy\"}[$__range])))",
     "legendFormat": "",
     "format": "table",
     "instant": true
    },
    {
     "refId": "E",
     "expr": "sum by (strategy) (increase(routerlab_llm_calls_total{strategy=~\"$strategy\"}[$__range])) / sum by (strategy) (increase(routerlab_requests_total{strategy=~\"$strategy\"}[$__range]))",
     "legendFormat": "",
     "format": "table",
     "instant": true
    },
    {
     "refId": "F",
     "expr": "sum by (strategy) (increase(routerlab_requests_total{strategy=~\"$strategy\"}[$__range]))",
     "legendFormat": "",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value #A": "accuracy",
       "Value #B": "$ per 1k requests",
       "Value #C": "saved vs strongest %",
       "Value #D": "p95 latency (s)",
       "Value #E": "LLM calls / request",
       "Value #F": "requests"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "accuracy",
        "desc": true
       }
      ]
     }
    }
   ]
  },
