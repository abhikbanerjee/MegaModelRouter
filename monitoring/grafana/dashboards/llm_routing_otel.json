{
 "title": "LLM Routing (OTel)",
 "uid": "routerlab-otel",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "routing",
  "otel"
 ],
 "panels": [
  {
   "type": "row",
   "title": "Is routing paying off?  (vs. sending everything to the strongest model)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "stat",
   "title": "Cost saved",
   "description": "1 - routed $ / $ if every request had gone to the strongest model",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "id": 2,
   "options": {},
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - sum(increase(routerlab_cost_usd_total{strategy=~\"$strategy\"}[$__range])) / sum(increase(routerlab_baseline_cost_usd_total{strategy=~\"$strategy\"}[$__range])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "type": "stat",
   "title": "Live accuracy",
   "description": "From /feedback (loadgen scores every answer)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1
    },
    "overrides": []
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "id": 3,
   "options": {},
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(routerlab_feedback_total{strategy=~\"$strategy\",correct=\"true\"}[$__range])) / sum(increase(routerlab_feedback_total{strategy=~\"$strategy\"}[$__range]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "type": "stat",
   "title": "Spend (range)",
